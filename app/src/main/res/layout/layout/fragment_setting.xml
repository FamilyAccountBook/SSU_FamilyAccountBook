<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 뒤로가기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="뒤로가기" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="뒤로가기"
                android:textSize="16sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- 프로필 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/setting_avatar_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="7dp"
                    android:contentDescription="프로필 이미지"
                    android:src="@drawable/ic_child_avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="김자녀"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="child@demo.com"
                        android:textColor="#777"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="자녀 계정"
                        android:textColor="#999"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="️ 수정"
                    android:background="@drawable/card_background_rounded"
                    android:padding="10dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 가족 추가 요청 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background_rounded"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="1dp">

            <TextView
                android:text="가족 추가 요청"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="부모 계정과 연결하세요"
                android:textColor="#666"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="👪"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="가족 찾기" />

                <TextView
                    android:text="이메일로 가족 찾기"
                    android:layout_marginStart="6dp"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:text="열기 →"
                    android:textSize="14sp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- 저축 목표 설정 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background_rounded"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:text="저축 목표 설정"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_save_goal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="저축 목표를 설정해주세요"
                    android:inputType="number"
                    android:background="@color/grey_100"
                    android:padding="10dp"
                    android:textSize="15sp" />
                <ImageView
                    android:src="@drawable/iv_setting_save"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:text="저장"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:text="10,000원을 저축할 거예요! 💪"
                android:textColor="#777"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 지출 한도 설정 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background_rounded"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:text="지출 한도 설정"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_spend_limit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="지출 한도를 설정해주세요"
                    android:inputType="number"
                    android:background="@color/grey_100"
                    android:padding="10dp"
                    android:textSize="15sp" />

                <ImageView
                    android:src="@drawable/iv_setting_save"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:text="저장"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:text="40,000원을 넘지 않도록 주의하세요! ⚠️"
                android:textColor="#777"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 카테고리 관리 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background_rounded"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:text="카테고리 관리"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="수입/지출 카테고리를 추가하거나 수정하세요"
                android:textColor="#666"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="📂"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="카테고리 관리" />

                <TextView
                    android:text="카테고리 추가 및 관리"
                    android:layout_marginStart="6dp"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:text="열기 →"
                    android:textColor="#000"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

<!--        로그아웃-->
        <LinearLayout
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#D4183D"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:text="로그아웃"
                android:textSize="16dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
