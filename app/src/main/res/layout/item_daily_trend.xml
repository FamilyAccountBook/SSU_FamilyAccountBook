<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_round14_white_stroke_1a"
    android:paddingTop="27dp"
    android:paddingBottom="27dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDailyTrendTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="일별 추이"
            android:textColor="#0A0A0A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDailyTrendSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수입과 지출의 일별 변화"
            android:textColor="#717182"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvLegendIncome2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="수입"
                android:textColor="#10B981"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tvLegendExpense2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="지출"
                android:textColor="#EF4444"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Chart area -->
    <FrameLayout
        android:id="@+id/dailyTrendChartSpace"
        android:layout_width="match_parent"
        android:layout_height="245dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:background="@drawable/bg_round14_stroke_none" />

</LinearLayout>
