<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="27dp"
    android:paddingBottom="27dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_daily_trend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="일별 추이"
            android:textColor="#0A0A0A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_daily_trend_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수입과 지출의 일별 변화"
            android:textColor="#717182"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/daily_trend_chart_space"
        android:layout_width="match_parent"
        android:layout_height="245dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:background="@drawable/bg_round14_stroke_none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@color/green_300" />

            <TextView
                android:id="@+id/tv_legend_income_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="수입"
                android:textColor="@color/green_300"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@color/red_300" />

            <TextView
                android:id="@+id/tv_legend_expense_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="지출"
                android:textColor="@color/red_300"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>